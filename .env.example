# Copy to .env and fill in. Placeholders only; never commit real values.

# Shared secret ManyChat sends in the X-Assistant-Secret header.
ASSISTANT_SECRET=change-me

# LLM (any OpenAI-compatible API; Groq by default).
GROQ_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Must stay well below the ManyChat external request timeout.
LLM_TIMEOUT_MS=3000

# Telegram notification for human handoff.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_API_BASE=https://api.telegram.org

# Leads sink (Apps Script web app) and its shared secret.
LEADS_URL=https://script.google.com/macros/s/your-deployment-id/exec
# Must equal the Script Property LEADS_SECRET in the Apps Script project (apps-script/README.md).
LEADS_SECRET=change-me
